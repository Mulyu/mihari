{
  "name": "mihari",
  "version": "0.1.0",
  "private": true,
  "description": "Local log file polling + bash runbook engine",
  "type": "module",
  "bin": {
    "mihari": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/cli.js",
    "check": "monban all",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.93.0",
    "commander": "14.0.3",
    "croner": "10.0.1",
    "pino": "9.14.0",
    "proper-lockfile": "4.1.2",
    "yaml": "2.8.3"
  },
  "devDependencies": {
    "@mulyu/monban": "0.2.5",
    "@types/node": "22.19.17",
    "@types/proper-lockfile": "4.1.4",
    "typescript": "5.9.3",
    "vitest": "4.1.5"
  },
  "engines": {
    "node": ">=20"
  }
}
