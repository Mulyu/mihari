{
  "name": "@mulyu/mihari",
  "version": "0.1.0",
  "description": "Local trigger-driven Claude agent runner",
  "type": "module",
  "bin": {
    "mihari": "dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/cli/index.js",
    "check": "monban all",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mulyu/mihari.git"
  },
  "homepage": "https://github.com/Mulyu/mihari#readme",
  "bugs": {
    "url": "https://github.com/Mulyu/mihari/issues"
  },
  "keywords": [
    "cli",
    "log",
    "monitoring",
    "runbook",
    "bash",
    "claude-code"
  ],
  "author": "mulyu",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.226",
    "@aws-sdk/client-cloudwatch": "3.1106.0",
    "@aws-sdk/client-cloudwatch-logs": "3.1106.0",
    "@datadog/datadog-api-client": "1.61.0",
    "commander": "14.0.3",
    "croner": "10.0.1",
    "pino": "9.14.0",
    "proper-lockfile": "4.1.2",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@mulyu/monban": "0.2.7",
    "@types/node": "24.13.3",
    "@types/proper-lockfile": "4.1.4",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
